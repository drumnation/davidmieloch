exports[`Storybook Component Snapshots > Pages/01-WhitePaper/02-AiAutopilotAnalogy/02-RealityVsHollywoodSection > Default 1`] = `
<div>
  <style>
    
      :root {
        --bg-gradient: linear-gradient(135deg, #2196f3 0%, #00bcd4 100%);
        --bg-light: #ffffff;
        --bg-dark: #1A1B1E;
        --text-light: #ffffff;
        --text-primary: #141517;
        --primary-blue: #2196f3;
        --accent-blue: #3182CE;
        --accent-red: #E53E3E;
        --accent-green: #38A169;
      }

      /* Add icon-specific styles */
      .icon-wrapper {
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .icon-wrapper svg {
        width: 100%;
        height: 100%;
      }
    
  </style>
  <div
    class="storybook-container"
    style="min-height: 100vh; width: 100%;"
  >
    <style
      data-mantine-styles="classes"
    >
      @media (max-width: 35.99375em) {.mantine-visible-from-xs {display: none !important;}}@media (min-width: 36em) {.mantine-hidden-from-xs {display: none !important;}}@media (max-width: 47.99375em) {.mantine-visible-from-sm {display: none !important;}}@media (min-width: 48em) {.mantine-hidden-from-sm {display: none !important;}}@media (max-width: 61.99375em) {.mantine-visible-from-md {display: none !important;}}@media (min-width: 62em) {.mantine-hidden-from-md {display: none !important;}}@media (max-width: 74.99375em) {.mantine-visible-from-lg {display: none !important;}}@media (min-width: 75em) {.mantine-hidden-from-lg {display: none !important;}}@media (max-width: 87.99375em) {.mantine-visible-from-xl {display: none !important;}}@media (min-width: 88em) {.mantine-hidden-from-xl {display: none !important;}}
    </style>
    <div
      style="max-width: 1000px; margin: 0px auto; padding: 20px;"
    >
      <h3
        class="sc-kghAKo dvCLgM mb-4"
      >
        AI Reality vs. Hollywood Fiction
      </h3>
      <div
        style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;"
      >
        <div>
          <h3
            class="sc-kghAKo dvCLgM mb-3"
          >
            Reality: AI Today
          </h3>
          <div
            style="display: flex; flex-direction: column; gap: 16px;"
          >
            <div
              style="padding: 16px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08); border-left: 4px solid #4285F4;"
            >
              <h3
                class="sc-kghAKo dvCLgM mb-2"
              >
                Context-Dependent
              </h3>
              <p
                class="sc-kghAKo fuQEuZ"
              >
                Today's AI tools are contextual assistants - the quality of output directly depends on the quality of input and context provided.
              </p>
            </div>
            <div
              style="padding: 16px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08); border-left: 4px solid #4285F4;"
            >
              <h3
                class="sc-kghAKo dvCLgM mb-2"
              >
                Pattern Recognition
              </h3>
              <p
                class="sc-kghAKo fuQEuZ"
              >
                AI excels at recognizing patterns in data and generating content similar to what it's been trained on.
              </p>
            </div>
            <div
              style="padding: 16px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08); border-left: 4px solid #4285F4;"
            >
              <h3
                class="sc-kghAKo dvCLgM mb-2"
              >
                Non-Sentient
              </h3>
              <p
                class="sc-kghAKo fuQEuZ"
              >
                Modern AI has no consciousness, desires, or understanding - it's a sophisticated pattern-matching system.
              </p>
            </div>
            <div
              style="padding: 16px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08); border-left: 4px solid #4285F4;"
            >
              <h3
                class="sc-kghAKo dvCLgM mb-2"
              >
                Requires Guidance
              </h3>
              <p
                class="sc-kghAKo fuQEuZ"
              >
                AI tools need strategic direction and quality checks from humans to be effectively utilized.
              </p>
            </div>
          </div>
        </div>
        <div>
          <h3
            class="sc-kghAKo dvCLgM mb-3"
          >
            Hollywood: AI Fiction
          </h3>
          <div
            style="display: flex; flex-direction: column; gap: 16px;"
          >
            <div
              style="padding: 16px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08); border-left: 4px solid #DB4437;"
            >
              <h3
                class="sc-kghAKo dvCLgM mb-2"
              >
                Magical Solution
              </h3>
              <p
                class="sc-kghAKo fuQEuZ"
              >
                In movies, AI is often portrayed as a magical solution that can solve any problem with minimal human input.
              </p>
            </div>
            <div
              style="padding: 16px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08); border-left: 4px solid #DB4437;"
            >
              <h3
                class="sc-kghAKo dvCLgM mb-2"
              >
                Human-Like Understanding
              </h3>
              <p
                class="sc-kghAKo fuQEuZ"
              >
                Fiction portrays AI with human-like comprehension of nuance, emotions, and abstract concepts.
              </p>
            </div>
            <div
              style="padding: 16px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08); border-left: 4px solid #DB4437;"
            >
              <h3
                class="sc-kghAKo dvCLgM mb-2"
              >
                Sentient or Conscious
              </h3>
              <p
                class="sc-kghAKo fuQEuZ"
              >
                Hollywood AI typically has its own goals, desires, and often develops self-awareness.
              </p>
            </div>
            <div
              style="padding: 16px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08); border-left: 4px solid #DB4437;"
            >
              <h3
                class="sc-kghAKo dvCLgM mb-2"
              >
                Autonomous Decision-Making
              </h3>
              <p
                class="sc-kghAKo fuQEuZ"
              >
                Fictional AI makes complex decisions independently, without human oversight or intervention.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;

