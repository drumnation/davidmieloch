            >
              Item 2
            </div>
            <div
              style="padding: 0.5rem; background: rgb(249, 240, 255); margin-bottom: 0.5rem; opacity: 0; transform: translateY(50px) translateZ(0);"
            >
              Item 3
            </div>
            <div
              style="padding: 0.5rem; background: rgb(249, 240, 255); margin-bottom: 0.5rem; opacity: 0; transform: translateY(50px) translateZ(0);"
            >
              Item 4
            </div>
          </div>
        </section>
        <section
          style="margin-top: 2rem;"
        >
          <h3>
            Variants-based Animation
          </h3>
          <div
            style="padding: 1rem; background: rgb(255, 240, 246); width: 100%; max-width: 300px; opacity: 0; transform: scale(0.8) rotate(-5deg) translateZ(0);"
          >
            This uses custom variants with scale and rotation
          </div>
        </section>
      </div>
    </div>
  </div>
</div>
`;
