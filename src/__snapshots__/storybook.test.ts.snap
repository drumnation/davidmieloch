exports[`Storybook Component Snapshots > Utils/Animations/FramerMotionTest > Default 1`] = `
<div>
  <style>
    
      :root {
        --bg-gradient: linear-gradient(135deg, #2196f3 0%, #00bcd4 100%);
        --bg-light: #ffffff;
        --bg-dark: #1A1B1E;
        --text-light: #ffffff;
        --text-primary: #141517;
        --primary-blue: #2196f3;
        --accent-blue: #3182CE;
        --accent-red: #E53E3E;
        --accent-green: #38A169;
      }

      /* Add icon-specific styles */
      .icon-wrapper {
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .icon-wrapper svg {
        width: 100%;
        height: 100%;
      }
    
  </style>
  <div
    class="storybook-container"
    style="min-height: 100vh; width: 100%;"
  >
    <style
      data-mantine-styles="classes"
    >
      @media (max-width: 35.99375em) {.mantine-visible-from-xs {display: none !important;}}@media (min-width: 36em) {.mantine-hidden-from-xs {display: none !important;}}@media (max-width: 47.99375em) {.mantine-visible-from-sm {display: none !important;}}@media (min-width: 48em) {.mantine-hidden-from-sm {display: none !important;}}@media (max-width: 61.99375em) {.mantine-visible-from-md {display: none !important;}}@media (min-width: 62em) {.mantine-hidden-from-md {display: none !important;}}@media (max-width: 74.99375em) {.mantine-visible-from-lg {display: none !important;}}@media (min-width: 75em) {.mantine-hidden-from-lg {display: none !important;}}@media (max-width: 87.99375em) {.mantine-visible-from-xl {display: none !important;}}@media (min-width: 88em) {.mantine-hidden-from-xl {display: none !important;}}
    </style>
    <div
      class="framer-motion-test"
      style="padding: 2rem;"
    >
      <h2>
        Framer Motion Animation Tests
      </h2>
      <section>
        <h3>
          Simple Fade In
        </h3>
        <div>
          <div
            style="padding: 1rem; background: rgb(240, 240, 240);"
          >
            This content fades in with a slight delay
          </div>
        </div>
      </section>
      <section
        style="margin-top: 2rem;"
      >
        <h3>
          Slide Up Animation
        </h3>
        <div>
          <div
            style="padding: 1rem; background: rgb(230, 247, 255);"
          >
            This content slides up from below
          </div>
        </div>
      </section>
      <section
        style="margin-top: 2rem;"
      >
        <h3>
          Staggered Trail Animation
        </h3>
        <div>
          <div
            style="padding: 0.5rem; background: rgb(249, 240, 255); margin-bottom: 0.5rem; opacity: 0; transform: translateY(50px) translateZ(0);"
          >
            Item 1
          </div>
          <div
            style="padding: 0.5rem; background: rgb(249, 240, 255); margin-bottom: 0.5rem; opacity: 0; transform: translateY(50px) translateZ(0);"
          >
            Item 2
          </div>
          <div
            style="padding: 0.5rem; background: rgb(249, 240, 255); margin-bottom: 0.5rem; opacity: 0; transform: translateY(50px) translateZ(0);"
          >
            Item 3
          </div>
          <div
            style="padding: 0.5rem; background: rgb(249, 240, 255); margin-bottom: 0.5rem; opacity: 0; transform: translateY(50px) translateZ(0);"
          >
            Item 4
          </div>
        </div>
      </section>
      <section
        style="margin-top: 2rem;"
      >
        <h3>
          Variants-based Animation
        </h3>
        <div
          style="padding: 1rem; background: rgb(255, 240, 246); width: 100%; max-width: 300px; opacity: 0; transform: scale(0.8) rotate(-5deg) translateZ(0);"
        >
          This uses custom variants with scale and rotation
        </div>
      </section>
    </div>
  </div>
</div>
`;

