{
  "name": "david-portfolio",
  "version": "0.21.11",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:port": "next dev -p",
    "dev:alt": "next dev -p 3002",
    "dev:turbo": "next dev -p 4000 --turbo",
    "dev:fast": "NODE_OPTIONS='--max-old-space-size=4096' next dev -p 4000",
    "dev:stories": "concurrently \"pnpm storybook\" \"pnpm test:storybook:watch\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --project tsconfig.json --noEmit",
    "vercel-check": "tsc --project tsconfig.json --noEmit && next build",
    "clean:js": "find ./src -name \"*.js\" -type f -delete",
    "storybook": "NODE_OPTIONS='--max-old-space-size=4096' storybook dev -p 7010 --no-open --no-version-updates",
    "build-storybook": "storybook build",
    "killports": "kill-port 3000 3001 3002 3003 3004 3333 6006 6007 7000 4000 || true",
    "content:pipeline": "node --import tsx scripts/content-pipeline.mjs",
    "content:launch-gate": "node --import tsx scripts/content-pipeline.mjs launch:assets",
    "content:release-workflow": "node --import tsx scripts/content-pipeline.mjs content:release-workflow",
    "release:status": "node --import tsx scripts/content-pipeline.mjs site:release-status --live",
    "site:release-ladder": "node --import tsx scripts/content-pipeline.mjs site:release-ladder",
    "brand:logo": "node scripts/generate-brand-logo.mjs",
    "draft:image-review": "node scripts/write-draft-image-review.mjs",
    "draft:decision": "node scripts/set-draft-decision.mjs",
    "content:observe": "node --import tsx scripts/content-pipeline.mjs observe:bootstrap",
    "contact:check": "node scripts/check-contact-routing.mjs",
    "contact:twenty:check": "node scripts/check-twenty-routing.mjs",
    "postinstall": "node scripts/patch-react-floater-types.mjs",
    "process-linkedin": "node scripts/process-linkedin-data.js",
    "generate-pdf-thumbnails": "node scripts/generate-pdf-thumbnails.js",
    "prepare": "husky",
    "test:snapshots": "npx vitest --config vitest.config.snapshot.ts",
    "test:snapshots:update": "npx vitest --config vitest.config.snapshot.ts -u",
    "test:snapshots:watch": "npx vitest --config vitest.config.snapshot.ts --watch",
    "test:stories": "npx vitest --config vitest.config.stories.ts",
    "test:stories:watch": "npx vitest --config vitest.config.stories.ts --watch",
    "test:storybook": "npx vitest --config vitest.config.storybook.ts src/storybook.test.tsx",
    "test:storybook:all": "npx vitest --config vitest.config.storybook.ts src/storybook-all.test.tsx",
    "test:storybook:update": "npx vitest --config vitest.config.storybook.ts -u",
    "test:storybook:watch": "npx vitest --config vitest.config.storybook.ts --watch",
    "test:storybook:normalize": "node scripts/normalize-snapshots.js",
    "test:storybook:stable": "pnpm test:storybook:update && pnpm test:storybook:normalize && pnpm test:storybook:all",
    "test:e2e:loader": "node scripts/e2e-loader-check.mjs",
    "test:e2e:narration": "node scripts/e2e-narration-check.mjs",
    "test:ci": "pnpm exec vitest --config vitest.config.snapshot.ts --run && pnpm exec vitest --config vitest.config.stories.ts --run"
  },
  "// comments": {
    "pdf-thumbnails": "Requires pdftoppm from poppler-utils to be installed on the system for PDF page extraction"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mantine/carousel": "^7.17.4",
    "@mantine/core": "^7.17.1",
    "@mantine/dates": "^7.17.1",
    "@mantine/dropzone": "^7.17.3",
    "@mantine/form": "^7.17.1",
    "@mantine/hooks": "^7.17.5",
    "@mantine/notifications": "^7.17.5",
    "@microsoft/clarity": "^1.0.0",
    "@react-spring/animated": "9.5.5",
    "@react-spring/core": "9.5.5",
    "@react-spring/shared": "9.5.5",
    "@react-spring/web": "^9.5.5",
    "@reduxjs/toolkit": "^2.6.1",
    "@tabler/icons-react": "^3.31.0",
    "@types/dagre": "^0.7.52",
    "@types/nodemailer": "^6.4.17",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xyflow/react": "^12.4.4",
    "axios": "^1.6.0",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "dagre": "^0.8.5",
    "dayjs": "^1.11.13",
    "embla-carousel-auto-height": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "10.18.0",
    "html2pdf.js": "^0.10.3",
    "lucide-react": "^0.479.0",
    "mammoth": "^1.9.0",
    "mermaid": "^11.6.0",
    "next": "15.2.1",
    "nodemailer": "^6.10.1",
    "openai": "^4.97.0",
    "pdfjs-dist": "^5.1.91",
    "phosphor-react": "^1.4.1",
    "puppeteer": "^21.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-joyride": "3.0.0-7",
    "react-markdown": "^10.1.0",
    "react-player": "^2.16.0",
    "react-redux": "^9.2.0",
    "react-spinners": "^0.15.0",
    "react-syntax-highlighter": "^15.6.1",
    "styled-components": "^6.1.16",
    "tesseract.js": "^6.0.0",
    "vscode-languageserver-types": "^3.17.5",
    "wavesurfer.js": "^7.9.1",
    "zod": "^3.24.3"
  },
  "optionalDependencies": {
    "canvas": "^2.11.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.5",
    "@eslint/eslintrc": "^3",
    "@next/eslint-plugin-next": "^15.3.1",
    "@storybook/addon-essentials": "^8.6.11",
    "@storybook/addon-onboarding": "^8.6.11",
    "@storybook/addon-viewport": "^8.6.12",
    "@storybook/blocks": "^8.6.11",
    "@storybook/core": "8.6.11",
    "@storybook/experimental-addon-test": "^8.6.11",
    "@storybook/nextjs": "8.6.11",
    "@storybook/preview-api": "^8.6.12",
    "@storybook/react": "^8.6.11",
    "@storybook/test": "^8.6.11",
    "@storybook/testing-react": "^2.0.1",
    "@tanstack/react-query": "^5.74.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.2.18",
    "@types/react-icons": "^3.0.0",
    "@types/styled-components": "^5.1.34",
    "@types/webpack": "^5.28.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^3.0.8",
    "@vitest/coverage-v8": "^3.0.8",
    "babel-loader": "^10.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "15.2.1",
    "eslint-plugin-storybook": "^0.11.4",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "kill-port": "^2.0.1",
    "lint-staged": "^15.5.0",
    "next-router-mock": "^0.9.13",
    "pdf-lib": "^1.17.1",
    "react-intersection-observer": "^9.16.0",
    "reactflow": "^11.11.4",
    "rimraf": "^6.0.1",
    "sharp": "^0.33.5",
    "storybook": "^8.6.11",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.2"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "bash -c \"pnpm type-check\""
    ],
    "*.stories.{ts,tsx}": [
      "bash -c \"CI=true pnpm test:stories --run\""
    ]
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
